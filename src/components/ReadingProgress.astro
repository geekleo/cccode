---
/**
 * Tracks reading progress per lesson using localStorage.
 * Shows a top progress bar on article pages and marks lessons as "read" in sidebar/cards.
 */
interface Props {
  lessonId: string;
  section: string;
}

const { lessonId, section } = Astro.props;
const storageKey = `progress:${section}/${lessonId}`;
---

<!-- Reading progress bar (top of viewport) -->
<div
  id="reading-progress-bar"
  class="fixed left-0 top-16 z-40 h-0.5 bg-primary-500 transition-all duration-150"
  style="width: 0%"
></div>

<script is:inline define:vars={{ storageKey, lessonId, section }}>
(function() {
  const bar = document.getElementById('reading-progress-bar');
  let maxScroll = 0;

  function getScrollPercent() {
    const h = document.documentElement;
    const st = h.scrollTop || document.body.scrollTop;
    const sh = h.scrollHeight - h.clientHeight;
    return sh > 0 ? Math.round((st / sh) * 100) : 0;
  }

  function updateBar() {
    const pct = getScrollPercent();
    if (bar) bar.style.width = pct + '%';
    if (pct > maxScroll) maxScroll = pct;

    // Mark as read when scrolled past 80%
    if (maxScroll >= 80) {
      markAsRead();
    }
  }

  function markAsRead() {
    try {
      const progress = JSON.parse(localStorage.getItem('cc_reading_progress') || '{}');
      if (!progress[section]) progress[section] = {};
      if (!progress[section][lessonId]) {
        progress[section][lessonId] = { readAt: new Date().toISOString(), percent: 100 };
        localStorage.setItem('cc_reading_progress', JSON.stringify(progress));
      }
    } catch (e) {}
  }

  // Save partial progress on leave
  function savePartialProgress() {
    try {
      const progress = JSON.parse(localStorage.getItem('cc_reading_progress') || '{}');
      if (!progress[section]) progress[section] = {};
      const existing = progress[section][lessonId];
      if (!existing || !existing.readAt) {
        progress[section][lessonId] = { ...existing, percent: maxScroll, lastVisit: new Date().toISOString() };
        localStorage.setItem('cc_reading_progress', JSON.stringify(progress));
      }
    } catch (e) {}
  }

  window.addEventListener('scroll', updateBar, { passive: true });
  window.addEventListener('beforeunload', savePartialProgress);
  updateBar();
})();
</script>
