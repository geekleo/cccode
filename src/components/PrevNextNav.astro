---
interface LessonLink {
  title: string;
  href: string;
}

interface Props {
  prev?: LessonLink;
  next?: LessonLink;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="mt-14 pt-8 border-t border-gray-200 dark:border-gray-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {prev ? (
      <a
        href={prev.href}
        class="card-hover group flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 hover:border-primary-300 hover:shadow-md hover:shadow-primary-500/5 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-primary-700"
      >
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400 transition-colors group-hover:bg-primary-50 group-hover:text-primary-600 dark:bg-gray-800 dark:text-gray-500 dark:group-hover:bg-primary-950 dark:group-hover:text-primary-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </div>
        <div class="min-w-0">
          <span class="text-xs text-gray-400 dark:text-gray-500">上一篇</span>
          <span class="mt-0.5 block truncate text-sm font-medium text-gray-900 transition-colors group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
            {prev.title}
          </span>
        </div>
      </a>
    ) : (
      <div></div>
    )}
    {next && (
      <a
        href={next.href}
        class="card-hover group flex items-center justify-end gap-3 rounded-xl border border-gray-200 bg-white p-4 hover:border-primary-300 hover:shadow-md hover:shadow-primary-500/5 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-primary-700"
      >
        <div class="min-w-0 text-right">
          <span class="text-xs text-gray-400 dark:text-gray-500">下一篇</span>
          <span class="mt-0.5 block truncate text-sm font-medium text-gray-900 transition-colors group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
            {next.title}
          </span>
        </div>
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400 transition-colors group-hover:bg-primary-50 group-hover:text-primary-600 dark:bg-gray-800 dark:text-gray-500 dark:group-hover:bg-primary-950 dark:group-hover:text-primary-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    )}
  </nav>
)}
