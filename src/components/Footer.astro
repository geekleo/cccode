---
import { SITE } from '@lib/constants';
import {
  learningPathSections,
  topicReferenceSections,
  referenceCatalogPages,
  communityPages,
  learningToolPages,
} from '@lib/navigation';
---

<footer class="border-t border-gray-200 bg-gray-50/80 dark:border-gray-800 dark:bg-gray-950/80">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <!-- Top: multi-column links -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-primary-700">
            <svg class="h-[16px] w-[16px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
          </div>
          <span class="text-sm font-bold text-gray-900 dark:text-white">{SITE.title}</span>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
          从入门到精通，全面掌握 Claude Code AI 编程助手。
        </p>
      </div>

      <!-- Learning path -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-900 dark:text-white">学习路径</h4>
        <ul class="mt-3 space-y-2">
          {learningPathSections.map((s) => (
            <li>
              <a href={s.urlPrefix} class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">
                {s.icon} {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Reference -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-900 dark:text-white">参考手册</h4>
        <ul class="mt-3 space-y-2">
          {topicReferenceSections.map((s) => (
            <li>
              <a href={s.urlPrefix} class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">
                {s.icon} {s.title}
              </a>
            </li>
          ))}
          {referenceCatalogPages.map((p) => (
            <li>
              <a href={p.href} class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">
                {p.icon} {p.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community & Support -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-900 dark:text-white">社区与支持</h4>
        <ul class="mt-3 space-y-2">
          {learningToolPages.map((p) => (
            <li>
              <a href={p.href} class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">
                {p.icon} {p.title}
              </a>
            </li>
          ))}
          {communityPages.map((p) => (
            <li>
              <a href={p.href} class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">
                {p.icon} {p.title}
              </a>
            </li>
          ))}
          <li><a href="https://docs.anthropic.com/en/docs/claude-code" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">📖 官方文档</a></li>
          <li><a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 transition-colors hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">GitHub</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-gray-200 pt-6 sm:flex-row dark:border-gray-800">
      <p class="text-xs text-gray-400 dark:text-gray-500">
        &copy; {new Date().getFullYear()} {SITE.title}. 基于 Astro 构建，内容使用 CC BY-SA 4.0 许可。
      </p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="text-xs text-gray-400 hover:text-primary-600 dark:text-gray-500 dark:hover:text-primary-400 transition-colors">RSS</a>
        <span class="text-gray-300 dark:text-gray-700">·</span>
        <a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-primary-600 dark:text-gray-500 dark:hover:text-primary-400 transition-colors">贡献指南</a>
      </div>
    </div>
  </div>
</footer>
