---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="hidden xl:block w-56 shrink-0">
    <div class="sticky top-20 p-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">
        目录
      </p>
      <ul class="flex flex-col gap-0.5 border-l border-gray-200 dark:border-gray-700" id="toc-list">
        {filteredHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'toc-link block border-l-2 -ml-px py-1 transition-all hover:text-primary-600 dark:hover:text-primary-400',
                heading.depth === 3 ? 'pl-6 text-xs' : 'pl-3 text-sm',
                'text-gray-500 dark:text-gray-400 border-transparent',
              ]}
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script is:inline>
  (function () {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.remove('text-primary-600', 'dark:text-primary-400', 'font-medium', 'border-primary-600', 'dark:border-primary-400');
              link.classList.add('text-gray-500', 'dark:text-gray-400', 'border-transparent');
            });
            const activeLink = document.querySelector(`.toc-link[data-slug="${entry.target.id}"]`);
            if (activeLink) {
              activeLink.classList.add('text-primary-600', 'dark:text-primary-400', 'font-medium', 'border-primary-600', 'dark:border-primary-400');
              activeLink.classList.remove('text-gray-500', 'dark:text-gray-400', 'border-transparent');
            }
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );

    document.querySelectorAll('h2[id], h3[id]').forEach((el) => observer.observe(el));
  })();
</script>
