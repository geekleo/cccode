---
import { localeNames, getLocaleFromUrl, type Locale } from '@lib/i18n';

const currentLocale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Build alternate locale paths
function getAlternatePath(targetLocale: Locale): string {
  if (targetLocale === 'zh-cn') {
    // Remove /en prefix
    return currentPath.replace(/^\/en/, '') || '/';
  }
  // Add /en prefix (remove existing locale prefix if any)
  const cleanPath = currentPath.replace(/^\/en/, '') || '/';
  return `/en${cleanPath === '/' ? '' : cleanPath}`;
}
---

<div class="relative" id="lang-switcher">
  <button
    type="button"
    id="lang-switcher-btn"
    class="flex items-center gap-1 rounded-lg px-2 py-1.5 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-300"
    aria-label="Switch language"
  >
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    {localeNames[currentLocale]}
  </button>
  <div
    id="lang-switcher-menu"
    class="absolute right-0 top-full mt-1 hidden w-32 rounded-lg border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-gray-900"
  >
    {Object.entries(localeNames).map(([locale, name]) => (
      <a
        href={getAlternatePath(locale as Locale)}
        class:list={[
          'flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors',
          locale === currentLocale
            ? 'bg-primary-50 text-primary-700 font-medium dark:bg-primary-950 dark:text-primary-300'
            : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white',
        ]}
      >
        {name}
        {locale === currentLocale && (
          <svg class="ml-auto h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        )}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  const langBtn = document.getElementById('lang-switcher-btn');
  const langMenu = document.getElementById('lang-switcher-menu');
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langMenu?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => {
    langMenu?.classList.add('hidden');
  });
</script>
