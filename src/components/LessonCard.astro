---
interface Props {
  title: string;
  description: string;
  href: string;
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
  readingTime?: number;
  index?: number;
}

const { title, description, href, difficulty, readingTime, index } = Astro.props;

const difficultyLabels = {
  beginner: { text: '入门', class: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' },
  intermediate: { text: '进阶', class: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400' },
  advanced: { text: '高级', class: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' },
};
---

<a
  href={href}
  class="card-hover group flex gap-4 rounded-xl border border-gray-200 bg-white p-5 hover:border-primary-300 hover:shadow-md hover:shadow-primary-500/5 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-primary-700"
>
  {index !== undefined && (
    <div class="lesson-number flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-sm font-bold text-gray-400 dark:bg-gray-800 dark:text-gray-500 group-hover:bg-primary-50 group-hover:text-primary-600 dark:group-hover:bg-primary-950 dark:group-hover:text-primary-400 transition-colors">
      {String(index).padStart(2, '0')}
    </div>
  )}
  <div class="min-w-0 flex-1">
    <h3 class="text-base font-semibold text-gray-900 transition-colors group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
      {title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-gray-500 line-clamp-2 dark:text-gray-400">
      {description}
    </p>
    <div class="mt-3 flex items-center gap-2">
      {difficulty && (
        <span class:list={['px-2 py-0.5 rounded-full text-xs font-medium', difficultyLabels[difficulty].class]}>
          {difficultyLabels[difficulty].text}
        </span>
      )}
      {readingTime && (
        <span class="flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          {readingTime} 分钟
        </span>
      )}
    </div>
  </div>
  <svg class="mt-1 h-4 w-4 shrink-0 text-gray-300 transition-transform group-hover:translate-x-0.5 group-hover:text-primary-500 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
  </svg>
</a>
