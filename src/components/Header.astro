---
import ThemeToggle from './ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  learningPathSections,
  topicReferenceSections,
  referenceCatalogPages,
  communityPages,
  learningToolPages,
  sections,
} from '@lib/navigation';

const pathname = Astro.url.pathname;

// Active state detection for dropdowns
const allReferenceHrefs = [
  ...topicReferenceSections.map((s) => s.urlPrefix),
  ...referenceCatalogPages.map((p) => p.href),
];
const allMoreHrefs = [
  ...learningToolPages.map((p) => p.href),
  ...communityPages.map((p) => p.href),
];
const isReferenceActive = allReferenceHrefs.some((h) => pathname.startsWith(h));
const isMoreActive = allMoreHrefs.some((h) => pathname.startsWith(h));
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-gray-800 dark:bg-gray-950/80">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-primary-700 shadow-sm transition-shadow group-hover:shadow-md">
        <svg class="h-[18px] w-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6" />
          <polyline points="8 6 2 12 8 18" />
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-lg font-bold tracking-tight text-gray-900 dark:text-white">Claude Code</span>
        <span class="rounded bg-primary-50 px-1.5 py-0.5 text-xs font-medium text-primary-600 dark:bg-primary-950/50 dark:text-primary-400">教程</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {learningPathSections.map((section) => {
        const isActive = pathname.startsWith(section.urlPrefix);
        return (
          <a
            href={section.urlPrefix}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
              isActive
                ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
            ]}
          >
            {section.titleShort}
          </a>
        );
      })}
      <div class="mx-2 h-5 w-px bg-gray-200 dark:bg-gray-700"></div>

      <!-- Reference dropdown -->
      <div class="relative">
        <button
          type="button"
          data-dropdown-btn
          data-dropdown-target="ref-dropdown-menu"
          class:list={[
            'flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
            isReferenceActive
              ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
          ]}
        >
          参考手册
          <svg class="h-3.5 w-3.5 transition-transform" data-dropdown-arrow fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="ref-dropdown-menu"
          class="absolute right-0 top-full mt-1 hidden w-52 rounded-xl border border-gray-200 bg-white p-1.5 shadow-lg dark:border-gray-700 dark:bg-gray-900"
        >
          <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">专题教程</div>
          {topicReferenceSections.map((section) => {
            const isActive = pathname.startsWith(section.urlPrefix);
            return (
              <a
                href={section.urlPrefix}
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-primary-50 text-primary-700 font-medium dark:bg-primary-950 dark:text-primary-300'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
                ]}
              >
                <span class="text-base">{section.icon}</span>
                {section.title}
              </a>
            );
          })}
          <div class="my-1.5 border-t border-gray-100 dark:border-gray-800"></div>
          <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">速查目录</div>
          {referenceCatalogPages.map((page) => {
            const isActive = pathname.startsWith(page.href);
            return (
              <a
                href={page.href}
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-primary-50 text-primary-700 font-medium dark:bg-primary-950 dark:text-primary-300'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
                ]}
              >
                <span class="text-base">{page.icon}</span>
                {page.title}
              </a>
            );
          })}
        </div>
      </div>

      <!-- More dropdown -->
      <div class="relative">
        <button
          type="button"
          data-dropdown-btn
          data-dropdown-target="more-dropdown-menu"
          class:list={[
            'flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
            isMoreActive
              ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
          ]}
        >
          更多
          <svg class="h-3.5 w-3.5 transition-transform" data-dropdown-arrow fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="more-dropdown-menu"
          class="absolute right-0 top-full mt-1 hidden w-52 rounded-xl border border-gray-200 bg-white p-1.5 shadow-lg dark:border-gray-700 dark:bg-gray-900"
        >
          {learningToolPages.map((page) => {
            const isActive = pathname.startsWith(page.href);
            return (
              <a
                href={page.href}
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-primary-50 text-primary-700 font-medium dark:bg-primary-950 dark:text-primary-300'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
                ]}
              >
                <span class="text-base">{page.icon}</span>
                {page.title}
              </a>
            );
          })}
          <div class="my-1.5 border-t border-gray-100 dark:border-gray-800"></div>
          {communityPages.map((page) => {
            const isActive = pathname.startsWith(page.href);
            return (
              <a
                href={page.href}
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-primary-50 text-primary-700 font-medium dark:bg-primary-950 dark:text-primary-300'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800',
                ]}
              >
                <span class="text-base">{page.icon}</span>
                {page.title}
              </a>
            );
          })}
          <div class="my-1.5 border-t border-gray-100 dark:border-gray-800"></div>
          <a
            href="https://docs.anthropic.com/en/docs/claude-code"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-gray-600 transition-colors hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800"
          >
            <span class="text-base">📖</span>
            官方文档
            <svg class="ml-auto h-3 w-3 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-2">
      <SearchDialog />
      <LanguageSwitcher />
      <ThemeToggle />
      <a
        href="https://github.com/anthropics/claude-code"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1.5 rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors hover:border-gray-300 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:bg-gray-700"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Star
      </a>
      <button
        id="mobile-nav-toggle"
        type="button"
        class="md:hidden p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700"
        aria-label="打开导航"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
    <nav class="flex flex-col p-4 gap-0.5">
      <!-- Learning path -->
      <div class="px-3 pt-1 pb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">学习路径</div>
      {learningPathSections.map((section) => {
        const isActive = pathname.startsWith(section.urlPrefix);
        return (
          <a href={section.urlPrefix} class:list={['px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800']}>
            <span class="mr-2">{section.icon}</span>{section.title}
          </a>
        );
      })}

      <!-- Reference -->
      <div class="mt-2 border-t border-gray-100 dark:border-gray-800"></div>
      <div class="px-3 pt-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">参考手册</div>
      {topicReferenceSections.map((section) => {
        const isActive = pathname.startsWith(section.urlPrefix);
        return (
          <a href={section.urlPrefix} class:list={['px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800']}>
            <span class="mr-2">{section.icon}</span>{section.title}
          </a>
        );
      })}
      {referenceCatalogPages.map((page) => {
        const isActive = pathname.startsWith(page.href);
        return (
          <a href={page.href} class:list={['px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800']}>
            <span class="mr-2">{page.icon}</span>{page.title}
          </a>
        );
      })}

      <!-- Tools & Community -->
      <div class="mt-2 border-t border-gray-100 dark:border-gray-800"></div>
      <div class="px-3 pt-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">工具与社区</div>
      {learningToolPages.map((page) => {
        const isActive = pathname.startsWith(page.href);
        return (
          <a href={page.href} class:list={['px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800']}>
            <span class="mr-2">{page.icon}</span>{page.title}
          </a>
        );
      })}
      {communityPages.map((page) => {
        const isActive = pathname.startsWith(page.href);
        return (
          <a href={page.href} class:list={['px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive ? 'bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800']}>
            <span class="mr-2">{page.icon}</span>{page.title}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script is:inline>
  // Mobile nav toggle
  document.getElementById('mobile-nav-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.toggle('hidden');
  });

  // Dropdown system: mutual exclusion, click-outside close, Escape close
  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-btn]').forEach((btn) => {
      const targetId = btn.getAttribute('data-dropdown-target');
      const menu = targetId ? document.getElementById(targetId) : null;
      const arrow = btn.querySelector('[data-dropdown-arrow]');
      menu?.classList.add('hidden');
      if (arrow) arrow.style.transform = '';
    });
  }

  document.querySelectorAll('[data-dropdown-btn]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-dropdown-target');
      const menu = targetId ? document.getElementById(targetId) : null;
      const arrow = btn.querySelector('[data-dropdown-arrow]');
      const wasHidden = menu?.classList.contains('hidden');
      closeAllDropdowns();
      if (wasHidden) {
        menu?.classList.remove('hidden');
        if (arrow) arrow.style.transform = 'rotate(180deg)';
      }
    });
  });

  document.addEventListener('click', closeAllDropdowns);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });
</script>
