---
interface Props {
  type?: 'tip' | 'warning' | 'info' | 'danger';
}

const { type = 'info' } = Astro.props;

const styles = {
  tip: {
    border: 'border-green-300 dark:border-green-700',
    bg: 'bg-green-50 dark:bg-green-950/30',
    iconBg: 'bg-green-100 dark:bg-green-900/40',
    icon: '💡',
    title: '提示',
    titleColor: 'text-green-800 dark:text-green-300',
  },
  warning: {
    border: 'border-amber-300 dark:border-amber-700',
    bg: 'bg-amber-50 dark:bg-amber-950/30',
    iconBg: 'bg-amber-100 dark:bg-amber-900/40',
    icon: '⚠️',
    title: '注意',
    titleColor: 'text-amber-800 dark:text-amber-300',
  },
  info: {
    border: 'border-blue-300 dark:border-blue-700',
    bg: 'bg-blue-50 dark:bg-blue-950/30',
    iconBg: 'bg-blue-100 dark:bg-blue-900/40',
    icon: 'ℹ️',
    title: '信息',
    titleColor: 'text-blue-800 dark:text-blue-300',
  },
  danger: {
    border: 'border-red-300 dark:border-red-700',
    bg: 'bg-red-50 dark:bg-red-950/30',
    iconBg: 'bg-red-100 dark:bg-red-900/40',
    icon: '🚫',
    title: '警告',
    titleColor: 'text-red-800 dark:text-red-300',
  },
};

const s = styles[type];
---

<div class:list={['my-6 overflow-hidden rounded-xl border', s.border, s.bg]}>
  <div class="flex items-start gap-3 p-4">
    <span class:list={['flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-sm', s.iconBg]}>
      {s.icon}
    </span>
    <div class="min-w-0 flex-1">
      <p class:list={['font-semibold text-sm mb-1', s.titleColor]}>
        {s.title}
      </p>
      <div class="text-sm leading-relaxed text-gray-700 dark:text-gray-300 [&>p]:m-0">
        <slot />
      </div>
    </div>
  </div>
</div>
