---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionOverview from '@components/SectionOverview.astro';
import { sections, learningPathSections, topicReferenceSections } from '@lib/navigation';
import { getCollection } from 'astro:content';

const lessonCounts: Record<string, number> = {};
let totalLessons = 0;
for (const section of sections) {
  const lessons = await getCollection(section.collectionName as any, ({ data }: any) => !data.draft);
  lessonCounts[section.id] = lessons.length;
  totalLessons += lessons.length;
}

const primarySections = learningPathSections;
const secondarySections = topicReferenceSections;
---

<BaseLayout title="Claude Code 教程 - 从入门到精通" description="全面掌握 Claude Code AI 编程助手，从安装配置到高级实战">
  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-primary-100/40 dark:from-primary-950/40 dark:via-gray-950 dark:to-primary-950/20"></div>
    <div class="bg-grid absolute inset-0"></div>
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary-200/30 blur-3xl dark:bg-primary-800/10"></div>
    <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-primary-100/40 blur-3xl dark:bg-primary-900/10"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50/80 px-3.5 py-1 text-sm text-primary-700 backdrop-blur dark:border-primary-800 dark:bg-primary-950/50 dark:text-primary-300">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-500 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-600 dark:bg-primary-400"></span>
        </span>
        Anthropic 官方 AI 编程助手
      </div>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-white">
        掌握 <span class="text-gradient">Claude Code</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-400">
        从安装到高级应用的完整教程。学习使用 Anthropic 官方 AI 编程助手，提升你的开发效率。
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="/beginner"
          class="group inline-flex items-center gap-2 rounded-xl bg-primary-600 px-7 py-3.5 font-semibold text-white shadow-lg shadow-primary-600/25 transition-all hover:bg-primary-700 hover:shadow-xl hover:shadow-primary-600/30 hover:-translate-y-0.5"
        >
          开始学习
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="/practical"
          class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white/80 px-7 py-3.5 font-semibold text-gray-700 backdrop-blur transition-all hover:bg-gray-50 hover:border-gray-400 hover:-translate-y-0.5 dark:border-gray-700 dark:bg-gray-900/80 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:border-gray-600"
        >
          查看实战项目
        </a>
      </div>
      <!-- Stats -->
      <div class="mt-14 flex flex-wrap gap-8 sm:gap-12">
        <div>
          <div class="text-3xl font-bold text-gray-900 dark:text-white">{sections.length}</div>
          <div class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">学习板块</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-gray-900 dark:text-white">{totalLessons}</div>
          <div class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">篇教程</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-gray-900 dark:text-white">100%</div>
          <div class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">免费开放</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Primary sections -->
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">学习路径</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">按照推荐顺序循序渐进，从基础到高级</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {primarySections.map((section, index) => (
        <SectionOverview section={section} lessonCount={lessonCounts[section.id]} index={index + 1} />
      ))}
    </div>
  </div>

  <!-- Secondary sections -->
  <div class="border-t border-gray-100 bg-gray-50/50 dark:border-gray-800/50 dark:bg-gray-900/30">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">专题内容</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">深入了解特定主题，拓展你的使用技巧</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {secondarySections.map((section) => (
          <SectionOverview section={section} lessonCount={lessonCounts[section.id]} />
        ))}
      </div>
    </div>
  </div>

  <!-- Community CTA -->
  <div class="border-t border-gray-100 dark:border-gray-800/50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-600 to-primary-800 px-8 py-12 text-white shadow-xl sm:px-12">
        <div class="bg-grid absolute inset-0 opacity-10"></div>
        <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative">
          <h2 class="text-2xl font-bold sm:text-3xl">加入社区，一起学习</h2>
          <p class="mt-3 max-w-xl text-primary-100">
            参与讨论、贡献内容、获取帮助。与其他 Claude Code 开发者共同成长。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/community" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-primary-700 shadow-sm transition-all hover:bg-primary-50 hover:-translate-y-0.5">
              加入社区
            </a>
            <a href="/resources" class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white backdrop-blur transition-all hover:bg-white/20 hover:-translate-y-0.5">
              资源合集
            </a>
            <a href="/changelog" class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white backdrop-blur transition-all hover:bg-white/20 hover:-translate-y-0.5">
              更新日志
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
