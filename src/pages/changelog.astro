---
import BaseLayout from '@layouts/BaseLayout.astro';

interface ChangelogEntry {
  date: string;
  version?: string;
  type: 'release' | 'content' | 'feature' | 'fix';
  title: string;
  items: string[];
}

const typeConfig = {
  release: { label: '版本发布', color: 'bg-green-50 text-green-700 dark:bg-green-950/50 dark:text-green-400' },
  content: { label: '内容更新', color: 'bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-400' },
  feature: { label: '功能上线', color: 'bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-400' },
  fix: { label: '问题修复', color: 'bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400' },
};

const changelog: ChangelogEntry[] = [
  {
    date: '2025-06-01',
    type: 'feature',
    title: '社区功能上线',
    items: [
      '新增全站搜索（Pagefind），支持 Cmd+K 快捷键',
      '新增 Giscus 评论系统，基于 GitHub Discussions',
      '新增 RSS 订阅功能',
      '新增社区页面、资源合集页面、更新日志页面',
      '新增贡献指南和 Issue 模板',
      '页脚改版为四栏布局',
    ],
  },
  {
    date: '2025-05-28',
    type: 'feature',
    title: '样式全面升级',
    items: [
      'Logo 和导航栏美化',
      '「更多」改为下拉菜单',
      '首页 Hero 区域增加装饰元素和统计数据',
      '卡片组件增加悬浮动效',
      '全局增加过渡动画和细节优化',
    ],
  },
  {
    date: '2025-05-25',
    type: 'content',
    title: '35 篇教程全部上线',
    items: [
      '入门篇 5 篇：安装、首次对话、基础命令、订阅方案、5 分钟快速上手',
      '进阶篇 6 篇：CLAUDE.md 基础/高级、Plan Mode、上下文管理、Hooks、Subagent',
      '高级篇 7 篇：MCP Server 入门/实战、插件开发、多 Agent、CI/CD、脚本化',
      '实战篇 5 篇：Web 应用、CLI 工具、API 服务、代码重构、Bug 调试',
      '多平台 5 篇：终端、VS Code、JetBrains、Web 版、Slack',
      '最佳实践 4 篇：Prompt 技巧、上下文优化、Token 管理、何时 /clear',
      '工具对比 3 篇：vs Copilot、vs Cursor、综合对比',
    ],
  },
  {
    date: '2025-05-20',
    type: 'release',
    title: '站点 v1.0 上线',
    version: '1.0.0',
    items: [
      '基于 Astro 5 + MDX + Tailwind CSS v4 构建',
      '7 个学习板块，完整的课程导航系统',
      '响应式三栏布局：侧边栏 + 文章 + 目录',
      '暗色模式支持',
      '语法高亮（astro-expressive-code）',
    ],
  },
  {
    date: '2025-05-15',
    version: '1.1.0',
    type: 'release',
    title: 'Claude Code 1.0.16 更新要点',
    items: [
      'Claude 新增 /memory 命令，自动管理 CLAUDE.md',
      '改进 Plan Mode 的交互体验',
      'MCP Server 支持 streamable HTTP transport',
      'Hooks 系统新增 notification 钩子',
      '修复 VS Code 扩展在 Windows 上的路径问题',
    ],
  },
];
---

<BaseLayout title="更新日志 - Claude Code 教程" description="Claude Code 教程站点更新记录和 Claude Code 版本变更">
  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50 to-white dark:from-primary-950/20 dark:to-gray-950"></div>
    <div class="bg-grid absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm ring-1 ring-gray-200 dark:bg-gray-800 dark:ring-gray-700">
        📋
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">更新日志</h1>
      <p class="mt-3 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        站点功能更新、内容发布、Claude Code 版本变更记录。
      </p>
    </div>
  </div>

  <!-- Timeline -->
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-[19px] top-2 bottom-2 w-px bg-gray-200 dark:bg-gray-800"></div>

      <div class="space-y-10">
        {changelog.map((entry) => {
          const config = typeConfig[entry.type];
          return (
            <div class="relative pl-12">
              {/* Dot */}
              <div class="absolute left-[13px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-primary-500 ring-2 ring-primary-100 dark:border-gray-950 dark:ring-primary-950/50"></div>

              {/* Header */}
              <div class="flex flex-wrap items-center gap-2">
                <time class="text-sm font-medium text-gray-500 dark:text-gray-400">{entry.date}</time>
                <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${config.color}`}>
                  {config.label}
                </span>
                {entry.version && (
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-mono font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                    v{entry.version}
                  </span>
                )}
              </div>

              {/* Title */}
              <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">{entry.title}</h3>

              {/* Items */}
              <ul class="mt-3 space-y-1.5">
                {entry.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Subscribe CTA -->
    <div class="mt-16 rounded-2xl border border-gray-200 bg-gray-50/50 px-6 py-8 text-center dark:border-gray-800 dark:bg-gray-900/30">
      <p class="font-semibold text-gray-900 dark:text-white">订阅更新</p>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">通过 RSS 订阅获取最新内容和更新通知。</p>
      <a
        href="/rss.xml"
        class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
        RSS 订阅
      </a>
    </div>
  </div>
</BaseLayout>
