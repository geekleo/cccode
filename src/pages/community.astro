---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="社区 - Claude Code 教程" description="加入 Claude Code 中文社区，与开发者交流学习">
  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50 to-white dark:from-primary-950/20 dark:to-gray-950"></div>
    <div class="bg-grid absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm ring-1 ring-gray-200 dark:bg-gray-800 dark:ring-gray-700">
        👥
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">加入社区</h1>
      <p class="mt-3 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        与 Claude Code 开发者交流经验，获取帮助，分享你的使用心得。
      </p>
    </div>
  </div>

  <!-- Channels -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <!-- GitHub Discussions -->
      <div class="card-hover rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gray-900 dark:bg-white">
          <svg class="h-6 w-6 text-white dark:text-gray-900" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">GitHub Discussions</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">提交 Issue、参与讨论、贡献代码。开源协作的主阵地。</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="https://github.com/anthropics/claude-code/discussions" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100">
            参与讨论
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          <a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
            Star
          </a>
        </div>
      </div>

      <!-- Discord -->
      <div class="card-hover rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[#5865F2]">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Discord 社区</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">实时交流、问答互助、分享经验。中英文频道均可参与。</p>
        <div class="mt-5">
          <a href="https://discord.gg/anthropic" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-[#5865F2] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[#4752C4]">
            加入 Discord
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>
      </div>

      <!-- WeChat -->
      <div class="card-hover rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[#07C160]">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 01.598.082l1.584.926a.272.272 0 00.14.045c.134 0 .24-.108.24-.243 0-.06-.024-.12-.04-.178l-.325-1.233a.49.49 0 01.177-.554C23.469 18.528 24.5 16.87 24.5 14.96c0-3.291-3.139-6.05-7.562-6.102zm-2.451 3.024c.535 0 .969.44.969.983a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.983.97-.983zm4.844 0c.535 0 .969.44.969.983a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.983.97-.983z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">微信交流群</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">关注公众号或添加微信，备注「Claude Code」加入中文交流群。</p>
        <div class="mt-5">
          <div class="inline-flex items-center gap-2 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-4 py-2 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            待配置：添加二维码图片
          </div>
        </div>
      </div>
    </div>

    <!-- How to contribute -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">参与贡献</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">多种方式参与到社区建设中来</p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-800">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-lg dark:bg-red-950/50">🐛</div>
          <h4 class="font-semibold text-gray-900 dark:text-white">报告问题</h4>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">发现内容错误或过时信息？提交 Issue 帮助我们改进。</p>
        </div>
        <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-800">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-lg dark:bg-blue-950/50">📝</div>
          <h4 class="font-semibold text-gray-900 dark:text-white">贡献内容</h4>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">撰写新教程、改进现有内容，通过 Pull Request 提交。</p>
        </div>
        <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-800">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-50 text-lg dark:bg-green-950/50">💡</div>
          <h4 class="font-semibold text-gray-900 dark:text-white">提出建议</h4>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">有好的教程想法或功能需求？欢迎提交 Feature Request。</p>
        </div>
        <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-800">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50 text-lg dark:bg-purple-950/50">🌐</div>
          <h4 class="font-semibold text-gray-900 dark:text-white">翻译协助</h4>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">帮助翻译为英文或其他语言，让更多人受益。</p>
        </div>
      </div>
    </div>

    <!-- Contributors wall placeholder -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">贡献者</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">感谢所有为本项目做出贡献的人</p>
      <div id="contributors-wall" class="mt-6 flex flex-wrap gap-2">
        <!-- Populated by client-side JS when repo is configured -->
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
        创建 GitHub 仓库后，贡献者头像将自动显示。
        <a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline dark:text-primary-400">成为贡献者 →</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // Auto-fetch contributors when repo is configured
  // TODO: Replace with your actual repo
  const REPO = '';  // e.g. 'your-username/cc-course'
  if (!REPO) return;

  const wall = document.getElementById('contributors-wall');
  if (!wall) return;

  fetch(`https://api.github.com/repos/${REPO}/contributors?per_page=50`)
    .then(r => r.json())
    .then(contributors => {
      wall.innerHTML = contributors.map(c => `
        <a href="${c.html_url}" target="_blank" rel="noopener noreferrer" title="${c.login} (${c.contributions} commits)" class="group relative">
          <img src="${c.avatar_url}&s=64" alt="${c.login}" class="h-10 w-10 rounded-full ring-2 ring-white transition-transform group-hover:scale-110 dark:ring-gray-900" loading="lazy" />
        </a>
      `).join('');
    })
    .catch(() => {});
})();
</script>
