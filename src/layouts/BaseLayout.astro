---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ConsultFloat from '@components/ConsultFloat.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, image, jsonLd } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <BaseHead title={title} description={description} image={image} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsultFloat />
  </body>
</html>
