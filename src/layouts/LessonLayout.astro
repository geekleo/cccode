---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import TableOfContents from '@components/TableOfContents.astro';
import PrevNextNav from '@components/PrevNextNav.astro';
import GiscusComments from '@components/GiscusComments.astro';
import ReadingProgress from '@components/ReadingProgress.astro';
import { sections } from '@lib/navigation';
import { SITE } from '@lib/constants';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface LessonLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  section: string;
  headings: Heading[];
  prevLesson?: LessonLink;
  nextLesson?: LessonLink;
  pubDate?: Date;
  updatedDate?: Date;
}

const { title, description, section, headings, prevLesson, nextLesson, pubDate, updatedDate } = Astro.props;
const sectionMeta = sections.find((s) => s.collectionName === section);

const breadcrumbItems = [
  ...(sectionMeta ? [{ label: sectionMeta.title, href: sectionMeta.urlPrefix }] : []),
  { label: title },
];

// JSON-LD: Article schema
const articleJsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: SITE.title },
  publisher: { '@type': 'Organization', name: SITE.title },
  image: new URL(`/og/${section}/${Astro.params.id}.svg`, Astro.site).href,
  inLanguage: 'zh-CN',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
if (pubDate) articleJsonLd.datePublished = pubDate.toISOString();
if (updatedDate) articleJsonLd.dateModified = updatedDate.toISOString();

// JSON-LD: BreadcrumbList schema
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
    ...(sectionMeta
      ? [{ '@type': 'ListItem', position: 2, name: sectionMeta.title, item: `${SITE.url}${sectionMeta.urlPrefix}` }]
      : []),
    { '@type': 'ListItem', position: sectionMeta ? 3 : 2, name: title },
  ],
};
---

<BaseLayout title={`${title} - Claude Code 教程`} description={description} jsonLd={[articleJsonLd, breadcrumbJsonLd]}>
  <ReadingProgress lessonId={Astro.params.id as string} section={section} />
  <div class="flex min-h-[calc(100vh-4rem)]">
    <Sidebar currentSection={section} currentLessonId={Astro.params.id as string} />

    <!-- Mobile sidebar toggle -->
    <button
      id="sidebar-toggle"
      class="fixed bottom-5 left-5 z-40 lg:hidden flex items-center justify-center w-12 h-12 rounded-full bg-primary-600 text-white shadow-lg shadow-primary-600/25 hover:bg-primary-700 hover:shadow-xl transition-all"
      aria-label="打开侧边栏"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h8m-8 6h16" />
      </svg>
    </button>

    <!-- Main content -->
    <div class="flex-1 min-w-0 px-4 py-8 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-3xl">
        <Breadcrumb items={breadcrumbItems} />
        <article class="prose prose-gray max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-headings:font-bold prose-h1:tracking-tight prose-h2:border-b prose-h2:border-gray-200 prose-h2:pb-2 dark:prose-h2:border-gray-800 prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-code:before:hidden prose-code:after:hidden prose-img:rounded-xl prose-img:shadow-md">
          <h1>{title}</h1>
          <slot />
        </article>
        <PrevNextNav prev={prevLesson} next={nextLesson} />
        <GiscusComments />
      </div>
    </div>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const toggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    if (!toggle || !sidebar) return;

    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('hidden');
      sidebar.classList.toggle('fixed');
      sidebar.classList.toggle('inset-y-0');
      sidebar.classList.toggle('left-0');
      sidebar.classList.toggle('z-50');
      sidebar.classList.toggle('w-64');
      sidebar.classList.toggle('shadow-xl');
    });
  })();
</script>
