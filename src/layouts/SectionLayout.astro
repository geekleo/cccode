---
import BaseLayout from './BaseLayout.astro';
import LessonCard from '@components/LessonCard.astro';
import type { SectionMeta } from '@lib/navigation';

interface Lesson {
  id: string;
  data: {
    title: string;
    description: string;
    difficulty?: 'beginner' | 'intermediate' | 'advanced';
    readingTime?: number;
  };
}

interface Props {
  section: SectionMeta;
  lessons: Lesson[];
}

const { section, lessons } = Astro.props;
---

<BaseLayout title={`${section.title} - Claude Code 教程`} description={section.description}>
  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50 to-white dark:from-primary-950/20 dark:to-gray-950"></div>
    <div class="bg-grid absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm ring-1 ring-gray-200 dark:bg-gray-800 dark:ring-gray-700">
        {section.icon}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">{section.title}</h1>
      <p class="mt-3 max-w-2xl text-lg text-gray-600 dark:text-gray-400">{section.description}</p>
      <div class="mt-4 flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700 dark:bg-primary-950/50 dark:text-primary-300">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          {lessons.length} 篇教程
        </span>
      </div>
    </div>
  </div>

  <!-- Lesson grid -->
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {lessons.map((lesson, i) => (
        <LessonCard
          title={lesson.data.title}
          description={lesson.data.description}
          href={`${section.urlPrefix}/${lesson.id}`}
          difficulty={lesson.data.difficulty}
          readingTime={lesson.data.readingTime}
          index={i + 1}
        />
      ))}
    </div>
  </div>
</BaseLayout>
